{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["./*.ts", "types.ts", "match_engine/events_queue.ts", "match_engine/game_modes_rules.ts", "commands_engine/commands_engine.ts"],
  "exclude": ["node_modules", "dist"]
}
